{
  "provider": {
    "type": "openai-compatible",
    "base_url": "$OPENAI_BASE_URL",
    "api_key": "$OPENAI_API_KEY"
  },
  "model": {
    "id": "gpt-4o",
    "temperature": 0.7,
    "max_tokens": 4096
  },
  "safety": {
    "auto_approve_low_risk": true,
    "blocked_commands": [
      "rm -rf /",
      "mkfs",
      "dd if="
    ]
  },
  "output": {
    "color": true,
    "stream": true,
    "show_thoughts": true,
    "show_tool_calls": true
  }
}